{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-ide-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
